# Telegram BotFather로 발급받은 봇 토큰
BOT_TOKEN=

# 관리자 본인의 Telegram 사용자 ID (숫자). @userinfobot 등으로 확인 가능
ADMIN_TELEGRAM_ID=

# Supabase 프로젝트의 Postgres 연결 문자열 (Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Google AI Studio에서 발급받은 Gemini API Key
GEMINI_API_KEY=

# (선택, M16 발음듣기 기능용) Google Cloud Console에서 발급받은 Text-to-Speech API Key
# https://console.cloud.google.com/apis/library/texttospeech.googleapis.com 에서 API 활성화 후
# "사용자 인증 정보"에서 API 키 생성. 비워두면 발음듣기 버튼은 안내 메시지만 보여주고 정상 동작한다.
GOOGLE_TTS_API_KEY=

# (선택) Telegram setWebhook 시 secret_token으로 등록해 webhook 요청을 검증
TELEGRAM_WEBHOOK_SECRET=

PORT=8000
